{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aws-map-it/data/regions.schema.json",
  "title": "AWS Region dataset (schemaVersion 1)",
  "description": "JSON Schema encoding DATA_CONTRACT.md sections 3/4/5 for the commercial aws-partition Region dataset.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedDate", "datasetProvenance", "regions"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "generatedDate": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "datasetProvenance": { "$ref": "#/$defs/provenance" },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/region" }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "retrievedDate", "accuracyNote", "license"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "retrievedDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "accuracyNote": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regionCode",
        "name",
        "lat",
        "lon",
        "country",
        "continent",
        "launchYear",
        "azCount",
        "geographyType",
        "provenance"
      ],
      "properties": {
        "regionCode": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "country": { "type": "string", "minLength": 1 },
        "continent": {
          "type": "string",
          "enum": [
            "North America",
            "South America",
            "Europe",
            "Africa",
            "Middle East",
            "Asia Pacific",
            "Oceania"
          ]
        },
        "launchYear": {
          "type": "integer",
          "minimum": 2006,
          "maximum": 2026
        },
        "azCount": { "type": "integer", "minimum": 1 },
        "geographyType": {
          "type": "string",
          "enum": ["commercial", "govcloud", "china"]
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    }
  }
}
